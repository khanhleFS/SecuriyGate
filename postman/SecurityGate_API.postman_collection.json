{
  "info": {
    "_postman_id": "a9182374-1290-4821-b492-securitygate-sep",
    "name": "SecurityGate - API Collection",
    "description": "Bộ sưu tập API cho hệ thống kiểm soát an ninh Security Gate (SEP490).\nBao gồm Authentication, Authorization JWT, Profile và tích hợp Test Script tự động lưu AccessToken vào Environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication (Công khai)",
      "item": [
        {
          "name": "1.1 Đăng ký tài khoản (Register)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van A\",\n  \"email\": \"{{test_email}}\",\n  \"username\": \"nguyenvana\",\n  \"phone\": \"0912345678\",\n  \"password\": \"{{test_password}}\",\n  \"confirmPassword\": \"{{test_password}}\",\n  \"address\": \"123 Nguyen Trai, Quan 1, TP.HCM\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Tạo tài khoản mới. Hệ thống sẽ sinh mã OTP 6 số gửi qua Email để kích hoạt."
          },
          "response": []
        },
        {
          "name": "1.2 Xác thực OTP kích hoạt (Verify Register OTP)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"otpCode\": \"{{test_otp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-register-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-register-otp"
              ]
            },
            "description": "Xác thực mã OTP nhận từ email (hoặc console log server) để chuyển trạng thái tài khoản sang Active."
          },
          "response": []
        },
        {
          "name": "1.3 Đăng nhập (Login - Auto Save Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Tự động trích xuất và gán AccessToken + RefreshToken vào Environment",
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json && json.result && json.result.accessToken) {",
                  "        pm.environment.set(\"accessToken\", json.result.accessToken);",
                  "        pm.environment.set(\"refreshToken\", json.result.refreshToken);",
                  "        console.log(\"[SUCCESS] Đã lưu accessToken vào Environment:\", json.result.accessToken);",
                  "    } else {",
                  "        console.warn(\"[WARNING] Không tìm thấy accessToken trong response result\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userNameOrEmail\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập và nhận accessToken. Test script sẽ tự động nạp accessToken vào Environment để các API sau tự động có quyền."
          },
          "response": []
        },
        {
          "name": "1.4 Gửi OTP Quên mật khẩu (Send Forgot Password OTP)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password/send-otp?email={{test_email}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password",
                "send-otp"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{test_email}}",
                  "description": "Email tài khoản cần khôi phục mật khẩu"
                }
              ]
            },
            "description": "Gửi OTP xác thực 6 số đến email để chuẩn bị đặt lại mật khẩu."
          },
          "response": []
        },
        {
          "name": "1.5 Đặt lại mật khẩu (Forgot Password Confirm)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"otpCode\": \"{{test_otp}}\",\n  \"newPassword\": \"NewPassword123@\",\n  \"confirmPassword\": \"NewPassword123@\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password"
              ]
            },
            "description": "Xác nhận OTP và đặt lại mật khẩu mới cho tài khoản."
          },
          "response": []
        }
      ]
    },
