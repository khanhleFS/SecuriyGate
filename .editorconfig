# ==============================================================================
# EditorConfig (Đồng bộ format code giữa các IDE: VSCode, IntelliJ, Android Studio)
# https://editorconfig.org
# ==============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java & Maven cấu hình thụt đầu dòng 4 khoảng trắng
[*.java]
indent_size = 4

[pom.xml]
indent_size = 4

# Web, Mobile, Scripts & Configs thụt đầu dòng 2 khoảng trắng
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

[*.dart]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
