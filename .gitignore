# ==========================================
# Root .gitignore (Dự án Monorepo SecurityGate)
# ==========================================

# IDEs and Editors
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Environment variables & Secrets (Tuyệt đối không push file .env chứa mật khẩu)
.env
.env.local
.env.*
!.env.example
*.pem
*.key

# Mobile Keys & Certificates (Flutter Android/iOS)
*.keystore
*.jks
key.properties

# Logs
*.log
logs/

# Build artifacts (được quản lý thêm ở từng subfolder)
target/
build/
dist/
.next/
out/
node_modules/
.dart_tool/
.turbo/

# Python & AI Research
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.pt
*.onnx
*.engine
*.tflite
*.weights

