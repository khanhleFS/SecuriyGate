# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Dùng làm mẫu cấu hình môi trường cho Local & Production.
# HƯỚNG DẪN: Sao chép tệp này thành .env và điền giá trị thực tế của bạn.
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env LÊN GITHUB!
# ==============================================================================

# -------------------------------------------------------------
# Database (PostgreSQL - Production)
# -------------------------------------------------------------
POSTGRES_DB=securitygate_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# -------------------------------------------------------------
# Database (MSSQL - Local Development)
# -------------------------------------------------------------
# MSSQL_URL=jdbc:sqlserver://localhost:1433;databaseName=securitygate_db;encrypt=true;trustServerCertificate=true;
# MSSQL_USERNAME=sa
# MSSQL_PASSWORD=YourStrong@Passw0rd

# -------------------------------------------------------------
# Cache & Blacklist Token (Redis)
# -------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -------------------------------------------------------------
# Backend (Spring Boot)
# -------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/securitygate_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me
JWT_SECRET=change_me_to_a_very_long_secure_secret_key_minimum_256_bits
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------
# Mail Server (SMTP Service - Phục vụ gửi mail production)
# -------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change_me
MAIL_FROM=SecurityGate <no-reply@example.com>

# -------------------------------------------------------------
# Frontend Web (Next.js)
# -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
